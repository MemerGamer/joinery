{
  "name": "review-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "bun run --filter '@review/server' dev",
    "dev:web": "bun run --filter '@review/web' dev",
    "start": "bun run --filter '@review/server' start",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '@review/web' build && bun run --filter '@review/cli' build",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/bun": "1.3.12"
  }
}
